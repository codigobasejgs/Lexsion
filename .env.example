# LexSion — variáveis de ambiente. SOMENTE NOMES; valores reais ficam no painel da Vercel e em .env.local (fora do Git).
# A demonstração (dados fictícios no navegador) não precisa de nenhuma variável.

# --- Público (vai para o navegador; pode ser visto por qualquer pessoa) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Somente servidor (NUNCA usar prefixo NEXT_PUBLIC_) ---
SUPABASE_SECRET_KEY=
SITE_URL=                     # https://lexsion.com.br (links de e-mail e webhooks)
CRON_SECRET=                  # >= 24 caracteres; o mesmo valor fica no Vault do Supabase (lexsion_cron_secret)

# E-mail transacional (Resend, conta da plataforma)
RESEND_API_KEY=

# WhatsApp (Evolution, servidor da plataforma; só instâncias "lexsion-*")
WHATSAPP_ENABLED=             # 1 = liberado; vazio = desligado (webhook responde 503 e nada é gravado)
EVOLUTION_URL=                # https://…
EVOLUTION_API_KEY=

# IA (Gemini, conta da plataforma; cada escritório habilita no próprio painel)
AI_ENABLED=                   # 1 = liberado
GEMINI_API_KEY=
GEMINI_MODEL=                 # padrão gemini-2.5-flash
AI_DAILY_LIMIT_PER_ORG=       # padrão 200 respostas automáticas por escritório em 24 h

# Cobrança da assinatura (InfinitePay)
SAAS_CHECKOUT_ENABLED=        # 1 = contratação pelo site liberada
INFINITEPAY_HANDLE=
INFINITEPAY_API_KEY=

# Backup cifrado (Cloudflare R2, bucket privado)
BACKUP_ENCRYPTION_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Apenas QA local (nunca em produção) ---
SAAS_CONFIG_NS=               # "qa" usa modelo e fornecedor de teste

# Inteligência Jurídica — OCR (Gemini) e DataJud
# GEMINI_OCR_MODEL=gemini-2.5-flash-lite   # modelo do OCR; preço precisa existir em ai_prices
# DATAJUD_API_KEY=                         # chave pública do CNJ (só servidor); uso comercial depende dos termos do CNJ

# LexSion — variáveis de ambiente. SOMENTE NOMES; valores reais ficam no painel da Vercel, nunca no Git.
# A demonstração (dados fictícios no navegador) não precisa de nenhuma variável.

# --- Público (vai para o navegador; pode ser visto por qualquer pessoa) ---
NEXT_PUBLIC_SUPABASE_URL=REPLACE_ME
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_ME

# --- Somente servidor (NUNCA usar prefixo NEXT_PUBLIC_) ---
SUPABASE_SECRET_KEY=REPLACE_ME
RESEND_API_KEY=REPLACE_ME
EVOLUTION_API_URL=REPLACE_ME
EVOLUTION_API_KEY=REPLACE_ME
ZAPSIGN_API_TOKEN=REPLACE_ME
ASAAS_API_KEY=REPLACE_ME

{
  "name": "siwiltec",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/stamp-sw.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "pwa:assets": "node scripts/pwa-assets.mjs",
    "capture:help": "node scripts/capture-help.mjs",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "capture:landing": "node scripts/capture-landing.mjs",
    "test:db": "vitest run -c vitest.db.config.mts",
    "test:real": "vitest run -c vitest.real.config.mts",
